{
  "openapi": "3.1.0",
  "info": {
    "title": "extractor.sh API",
    "version": "1.0.0",
    "description": "Extract supported public webpage, commerce, social, audio, podcast, and video URLs into clean Markdown or normalized JSON. The API is public, GET-only, and requires no authentication.",
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://extractor.mcb-software.workers.dev"
    }
  ],
  "externalDocs": {
    "description": "Agent-readable documentation",
    "url": "https://extractor.mcb-software.workers.dev/llms-full.txt"
  },
  "paths": {
    "/api/extract": {
      "get": {
        "operationId": "extractUrl",
        "summary": "Extract a public URL",
        "description": "Returns normalized JSON by default or raw Markdown when format=markdown. Results are cacheable and subject to per-client rate limits.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "Absolute public HTTP or HTTPS URL to extract.",
            "schema": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "example": "https://example.com/article"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Response representation.",
            "schema": {
              "type": "string",
              "enum": ["json", "markdown"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Extraction completed.",
            "headers": {
              "Cache-Control": {
                "schema": { "type": "string" }
              },
              "X-Extractor-Cache": {
                "description": "Whether the versioned Worker cache served the response.",
                "schema": { "type": "string", "enum": ["HIT", "MISS"] }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExtractionResult" }
              },
              "text/markdown": {
                "schema": { "type": "string" }
              }
            }
          },
          "400": {
            "description": "Missing or invalid query parameter.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "413": {
            "description": "Extracted content exceeds 2 MB.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "415": {
            "description": "The source is not an HTML, Markdown, or plain-text page.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "422": {
            "description": "The public URL could not be extracted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded.",
            "headers": {
              "Retry-After": {
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "502": {
            "description": "Upstream source failed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExtractedItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "author", "publishedAt", "content"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "type": ["string", "null"] },
          "author": { "type": ["string", "null"] },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "content": { "type": "string" }
        }
      },
      "ExtractionResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "source", "kind", "title", "author", "publishedAt", "content", "items"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "source": {
            "type": "string",
            "enum": ["web", "amazon", "bluesky", "instagram", "mastodon", "reddit", "shopify", "soundcloud", "spotify", "tiktok", "vimeo", "x", "youtube"]
          },
          "kind": {
            "type": "string",
            "enum": ["document", "feed"]
          },
          "title": { "type": ["string", "null"] },
          "author": { "type": ["string", "null"] },
          "publishedAt": { "type": ["string", "null"], "format": "date-time" },
          "content": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ExtractedItem" }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
