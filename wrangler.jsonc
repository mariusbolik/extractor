{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "extractor",
  "account_id": "f525f4afbff19582070c39b3ed311771",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "run_worker_first": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "ratelimits": [
    {
      "name": "EXTRACT_RATE_LIMITER",
      "namespace_id": "2026073101",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "BROWSER_RATE_LIMITER",
      "namespace_id": "2026073102",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "2026080201",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "allowed_destination_addresses": ["sideprojects@eyloo.com"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
