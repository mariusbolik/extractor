{
  "name": "extractor-sh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev --config astro.dev.config.mjs",
    "dev:worker": "astro dev",
    "build:mcp-apps": "vite build --config vite.mcp-app.config.ts",
    "build": "bun run build:mcp-apps && astro build",
    "preview": "astro preview",
    "check": "bun run build:mcp-apps && astro check",
    "test": "vitest run && vitest run --config vitest.worker.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:mcp-app": "bun scripts/smoke-mcp-app.mjs",
    "test:mcp": "bun scripts/smoke-mcp.mjs",
    "test:watch": "vitest",
    "test:smoke:prod": "bun scripts/smoke-production.mjs",
    "test:smoke:browser": "bun scripts/smoke-browser.mjs",
    "benchmark:extractors": "bun scripts/benchmark-extractors.mjs",
    "benchmark:metadata": "bun scripts/benchmark-metadata.mjs",
    "cf:types": "wrangler types",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry": "bun run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@cloudflare/puppeteer": "1.2.0",
    "@extractor/core": "workspace:*",
    "@fontsource/archivo-black": "^5.3.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.11",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/server": "2.0.0",
    "@teamhanko/hanko-elements": "^3.0.0",
    "@teamhanko/hanko-frontend-sdk": "^3.0.0",
    "agents": "0.20.1",
    "astro": "7.1.6",
    "astro-icon": "^1.1.5",
    "dodopayments": "2.44.0",
    "shiki": "4.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "defuddle": "^0.19.2",
    "linkedom": "0.18.13",
    "linkpeek": "^2.1.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  }
}
