    "@tailwindcss/vite": "^4.3.3",
    "@types/turndown": "5.0.6",
    "defuddle": "^0.19.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
