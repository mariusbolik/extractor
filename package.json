    "deploy:dry": "bun run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@cloudflare/puppeteer": "1.2.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/simple-icons": "^1.2.92",
    "@modelcontextprotocol/server": "2.0.0",
    "@mozilla/readability": "0.6.0",
    "agents": "0.20.1",
    "astro": "7.1.6",
    "astro-icon": "^1.1.5",
    "fast-xml-parser": "5.10.1",
    "linkedom": "0.18.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-tweet": "3.3.1",
    "shiki": "4.4.1",
    "tldts": "^7.4.10",
    "turndown": "7.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
