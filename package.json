    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke:prod": "bun scripts/smoke-production.mjs",
    "test:smoke:browser": "bun scripts/smoke-browser.mjs",
    "benchmark:extractors": "bun scripts/benchmark-extractors.mjs",
