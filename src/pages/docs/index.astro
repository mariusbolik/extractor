---
import { Icon } from 'astro-icon/components';
import DocsLayout from '../../layouts/DocsLayout.astro';

export const prerender = true;
const title = 'Developer documentation — extractor.sh';
const description = 'Developer documentation for extracting public web, news, commerce, social, audio, and video URLs as Markdown or typed JSON.';
---

<DocsLayout {title} {description} path="/docs/">
  <p class="!mt-0 font-mono text-[0.78rem] font-extrabold uppercase tracking-[0.14em]">Developer documentation</p>
  <h1>One endpoint.<br />Useful content.</h1>
  <p class="text-[1.08rem]">Send a normal public webpage URL to one GET endpoint. Receive readable Markdown or normalized JSON.</p>

  <pre><code>curl --get 'https://extractor.mcb-software.workers.dev/api/extract' \
  --data-urlencode 'url=https://example.com/article' \
  --data-urlencode 'format=markdown'</code></pre>

  <h2>Start here</h2>
  <div class="grid gap-4 sm:grid-cols-2">
    <a class="group border-2 border-black p-5 no-underline hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0_#000]" href="/docs/quickstart/">
      <span class="font-heading text-[1.05rem] font-normal">Quickstart</span>
      <span class="mt-3 block font-normal">Make your first Markdown and JSON requests.</span>
      <Icon class="mt-6 size-5" name="heroicons:arrow-right" aria-hidden="true" />
    </a>
    <a class="group border-2 border-black p-5 no-underline hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0_#000]" href="/docs/api/">
      <span class="font-heading text-[1.05rem] font-normal">API reference</span>
      <span class="mt-3 block font-normal">Parameters, responses, fields, and errors.</span>
      <Icon class="mt-6 size-5" name="heroicons:arrow-right" aria-hidden="true" />
    </a>
    <a class="group border-2 border-black p-5 no-underline hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0_#000]" href="/docs/sources/">
      <span class="font-heading text-[1.05rem] font-normal">Supported sources</span>
      <span class="mt-3 block font-normal">The public page URLs you can submit.</span>
      <Icon class="mt-6 size-5" name="heroicons:arrow-right" aria-hidden="true" />
    </a>
    <a class="group border-2 border-black p-5 no-underline hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0_#000]" href="/docs/schema/">
      <span class="font-heading text-[1.05rem] font-normal">JSON schema</span>
      <span class="mt-3 block font-normal">Types, shared fields, product prices, and collection items.</span>
      <Icon class="mt-6 size-5" name="heroicons:arrow-right" aria-hidden="true" />
    </a>
    <a class="group border-2 border-black p-5 no-underline hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0_#000]" href="/docs/limits/">
      <span class="font-heading text-[1.05rem] font-normal">Limits and caching</span>
      <span class="mt-3 block font-normal">Rate limits, cache lifetimes, and safe usage.</span>
      <Icon class="mt-6 size-5" name="heroicons:arrow-right" aria-hidden="true" />
    </a>
    <a class="group border-2 border-black p-5 no-underline hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[4px_4px_0_#000]" href="/docs/limitations/">
      <span class="font-heading text-[1.05rem] font-normal">Limitations</span>
      <span class="mt-3 block font-normal">CAPTCHAs, access controls, regions, and source boundaries.</span>
      <Icon class="mt-6 size-5" name="heroicons:arrow-right" aria-hidden="true" />
    </a>
  </div>

  <h2>Base URL</h2>
  <pre><code>https://extractor.mcb-software.workers.dev</code></pre>
  <p>The API currently requires no account, API key, or OAuth flow. Do not send credentials, cookies, private URLs, or private data.</p>
</DocsLayout>
