---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
const title = 'Contact extractor.sh';
const description = 'Ask a question or get help testing extractor.sh with your public URLs.';
---

<BaseLayout {title} {description} path="/contact/">
  <section class="pb-10 text-center">
    <p class="mb-4 font-mono text-[0.8rem] font-extrabold uppercase tracking-[0.14em]">Contact</p>
    <h1 class="mx-auto mb-6 max-w-[820px] font-heading text-[clamp(2.4rem,6vw,4.6rem)] font-normal leading-[1.03] tracking-[-0.045em]">Tell us what you need to extract.</h1>
    <p class="mx-auto max-w-[650px] text-[clamp(1.02rem,2vw,1.2rem)] leading-[1.65]">Send a public example URL and describe the result you need. We’ll help you work out whether extractor.sh fits.</p>
  </section>

  <section class="mx-auto mt-8 max-w-[760px] border-2 border-black bg-white p-[clamp(24px,5vw,48px)] shadow-[10px_10px_0_#000] max-[660px]:shadow-[6px_6px_0_#000]" aria-labelledby="contact-form-heading">
    <div class="mb-8 border-b-2 border-black pb-7">
      <p class="font-mono text-[0.78rem] font-extrabold uppercase tracking-[0.14em]">A real reply, not a ticket queue</p>
      <h2 class="mt-3 font-heading text-[clamp(1.45rem,3vw,2rem)] font-normal leading-tight" id="contact-form-heading">How can we help?</h2>
    </div>

    <div class="mb-7 hidden border-2 border-black p-4 text-[0.92rem] font-bold leading-relaxed" data-contact-status role="status" aria-live="polite"></div>

    <form class="space-y-6" action="/api/contact" method="post" data-contact-form>
      <div class="grid gap-6 sm:grid-cols-2">
        <label class="block">
          <span class="mb-2 block text-[0.9rem] font-extrabold">Name <span class="font-normal text-black/60">(optional)</span></span>
          <input class="min-h-[48px] w-full border-2 border-black bg-white px-4 py-3 outline-none" type="text" name="name" maxlength="100" autocomplete="name" />
        </label>
        <label class="block">
          <span class="mb-2 block text-[0.9rem] font-extrabold">Email</span>
          <input class="min-h-[48px] w-full border-2 border-black bg-white px-4 py-3 outline-none" type="email" name="email" maxlength="254" autocomplete="email" required />
        </label>
      </div>

      <label class="block">
        <span class="mb-2 block text-[0.9rem] font-extrabold">What is this about?</span>
        <select class="min-h-[48px] w-full rounded-none border-2 border-black bg-white px-4 py-3 outline-none" name="topic" required>
          <option value="extraction">Extraction help</option>
          <option value="pricing">Pricing question</option>
          <option value="partnership">Partnership</option>
          <option value="general">General question</option>
        </select>
      </label>

      <label class="block">
        <span class="mb-2 block text-[0.9rem] font-extrabold">Message</span>
        <textarea class="min-h-[190px] w-full resize-y border-2 border-black bg-white px-4 py-3 leading-relaxed outline-none" name="message" minlength="20" maxlength="4000" placeholder="Include a public example URL and what you want to extract." required></textarea>
      </label>

      <label class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>

      <p class="text-[0.8rem] leading-relaxed text-black/65">We use your details only to answer your request. Please do not send passwords, API keys, private URLs, or other sensitive information. See our <a class="font-bold text-black underline" href="/privacy/">Privacy Policy</a>.</p>
      <button class="inline-flex min-h-[52px] w-full items-center justify-center border-[2px_5px_5px_2px] border-black bg-white px-6 py-3 font-extrabold transition-transform hover:translate-x-[3px] hover:translate-y-[3px] hover:border-[2px] disabled:cursor-wait disabled:opacity-55" type="submit">Send message</button>
    </form>
  </section>

  <script is:inline>
    (() => {
      const form = document.querySelector('[data-contact-form]');
      const status = document.querySelector('[data-contact-status]');
      if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

      const showStatus = (message) => {
        status.textContent = message;
        status.classList.remove('hidden');
        status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      };

      const query = new URLSearchParams(location.search);
      if (query.get('sent') === '1') showStatus('Thanks — your message has been sent.');
      if (query.has('error')) showStatus('The message could not be sent. Check the fields and try again.');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const button = form.querySelector('button[type="submit"]');
        if (!(button instanceof HTMLButtonElement)) return;
        button.disabled = true;
        button.textContent = 'Sending…';
        status.classList.add('hidden');

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result?.error?.message || 'Send failed');
          form.reset();
          showStatus('Thanks — your message has been sent.');
        } catch (error) {
          showStatus(error instanceof Error ? error.message : 'The message could not be sent. Please try again.');
        } finally {
          button.disabled = false;
          button.textContent = 'Send message';
        }
      });
    })();
  </script>
</BaseLayout>
