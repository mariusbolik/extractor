---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLanding from '../components/SocialLanding.astro';

export const prerender = true;
const title = 'SoundCloud tracks and profiles to Markdown or JSON — extractor.sh';
const description = 'Extract public SoundCloud tracks, playlists, sets, and profiles into clean Markdown or normalized JSON.';
---

<BaseLayout {title} {description} path="/soundcloud/">
  <SocialLanding
    platform="SoundCloud"
    eyebrow="SoundCloud extractor"
    headline="Public audio metadata, minus the player."
    {description}
    outcome="Tracks, playlists, and profiles in one format."
    capabilities={[
      { label: 'Input', value: 'One public SoundCloud track, playlist, set, or creator profile URL.' },
      { label: 'Returns', value: 'One normalized metadata document.' },
      { label: 'Includes', value: 'Title, creator, public description, artwork, content type, and canonical URL when available.' },
      { label: 'Caching', value: 'Successful results may be cached at Cloudflare’s edge for up to 30 days.' },
    ]}
    supported={['Public SoundCloud tracks', 'Public playlists and sets', 'Public creator profile URLs']}
    limitations={['No private or deleted audio', 'No comments, waveform data, transcripts, or media downloads', 'The result describes the public audio; it does not analyze the recording']}
    exampleUrl="https://soundcloud.com/forss/flickermood"
  />
</BaseLayout>
