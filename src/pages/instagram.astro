---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLanding from '../components/SocialLanding.astro';

export const prerender = true;
const title = 'Instagram posts and profiles to Markdown or JSON — extractor.sh';
const description = 'Convert public Instagram posts, reels, and profiles into clean Markdown or normalized JSON.';
---

<BaseLayout {title} {description} path="/instagram/">
  <SocialLanding
    platform="Instagram"
    eyebrow="Instagram extractor"
    headline="Public Instagram content, made reusable."
    {description}
    outcome="Posts and profiles in one consistent format."
    capabilities={[
      { label: 'Input', value: 'One public Instagram post, reel, or profile URL.' },
      { label: 'Returns', value: 'One document for posts and reels, or a feed for profiles.' },
      { label: 'Includes', value: 'Caption, author, media type, timestamp, profile counts, and recent profile posts when exposed.' },
      { label: 'Caching', value: 'Profile feeds may be cached for one hour; post documents for up to 30 days.' },
    ]}
    supported={[
      'Public Instagram post and reel pages',
      'Public Instagram profile pages',
      'Recent public profile posts as a normalized feed',
    ]}
    limitations={[
      'No private, deleted, or login-only content',
      'No stories, comments, transcripts, or media downloads',
      'Public profile feeds may contain only the most recent posts',
    ]}
    exampleUrl="https://www.instagram.com/instagram/"
  />
</BaseLayout>
