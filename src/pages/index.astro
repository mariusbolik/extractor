---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExtractorForm from '../components/ExtractorForm.astro';
import MethodCards from '../components/MethodCards.astro';
import HeroBadge from '../components/HeroBadge.astro';
import { Icon } from 'astro-icon/components';

export const prerender = true;

const title = 'extractor.sh — Turn any public URL into clean Markdown or JSON';
const description = 'A simple, cache-first GET API that extracts public webpages and supported platforms into clean Markdown or normalized JSON.';
---

<BaseLayout {title} {description}>
  <section class="pb-[22px]">
    <p class="mb-4 font-mono text-[0.8rem] font-extrabold uppercase tracking-[0.14em]">URL → useful content</p>
    <div class="mb-5 flex items-center justify-between gap-4 sm:gap-8">
      <h1 class="min-w-0 max-w-[900px] font-heading text-[clamp(2.5rem,6vw,5.4rem)] font-normal leading-[1.02] tracking-[-0.045em]">The web,<br />minus the noise.</h1>
      <HeroBadge class="size-[clamp(96px,14vw,154px)]" />
    </div>
    <p class="mb-[42px] max-w-[720px] text-[clamp(1.1rem,2vw,1.35rem)] leading-[1.55]">Paste a public URL. Get clean Markdown or structured JSON through one aggressively cached GET request.</p>
  </section>

  <ExtractorForm />
  <MethodCards />

  <div class="mt-8 grid items-stretch gap-8 lg:grid-cols-2">
    <section id="api" class="flex min-w-0 flex-col border-2 border-black bg-white p-[clamp(24px,4vw,42px)] shadow-[8px_8px_0_#000] max-[660px]:shadow-[5px_5px_0_#000] [&_p]:leading-[1.7]">
      <div>
        <p class="mb-4 font-mono text-[0.8rem] font-extrabold uppercase tracking-[0.14em]">Public GET API</p>
        <h2 class="mb-5 font-heading text-[clamp(1.55rem,3vw,2.4rem)] font-normal leading-[1.02] tracking-[-0.045em]">Clean web data in one GET request.</h2>
        <p>Use the same endpoint as the form. JSON is normalized across sources; Markdown is returned as a raw <code>text/markdown</code> response.</p>
      </div>
      <pre class="mt-10 mb-0 max-w-full overflow-auto rounded-[3px] border-2 border-black bg-white p-5 font-mono text-[0.82rem] leading-[1.55] text-black"><code>curl --get \
  'https://extractor.sh/api/extract' \
  --data-urlencode 'url=https://www.amazon.de/dp/B09B8X9RGM' \
  --data-urlencode 'format=json'</code></pre>
    </section>

    <section id="mcp" class="flex min-w-0 flex-col border-2 border-black bg-white p-[clamp(24px,4vw,42px)] shadow-[8px_8px_0_#000] max-[660px]:shadow-[5px_5px_0_#000] [&_p]:leading-[1.7]">
      <div>
        <p class="mb-4 font-mono text-[0.8rem] font-extrabold uppercase tracking-[0.14em]">Hosted MCP server</p>
        <h2 class="mb-5 font-heading text-[clamp(1.55rem,3vw,2.4rem)] font-normal leading-[1.02] tracking-[-0.045em]">The MCP server for clean web data.</h2>
        <p>Connect an MCP client and call <code>extract_public_url</code>. It returns clean Markdown by default or the same normalized JSON as the public API.</p>
      </div>
      <pre class="mt-10 mb-0 max-w-full overflow-auto rounded-[3px] border-2 border-black bg-white p-5 font-mono text-[0.82rem] leading-[1.55] text-black"><code>https://extractor.sh/mcp</code></pre>
      <a class="mt-6 inline-flex self-start border-b-2 border-black pb-1 font-bold no-underline" href="/docs/mcp/">Read the MCP docs →</a>
    </section>
  </div>

  <a
    id="dlvr"
    class="group mt-8 grid items-center gap-5 border-2 border-black bg-black px-[clamp(20px,3vw,30px)] py-[clamp(18px,2.5vw,24px)] !text-white no-underline shadow-[8px_8px_0_#000] hover:!text-white max-[660px]:shadow-[5px_5px_0_#000] sm:grid-cols-[minmax(0,1fr)_auto]"
    href="https://dlvr.sh"
    target="_blank"
    rel="noopener noreferrer"
    data-dlvr-banner
  >
    <div>
      <p class="mb-2 font-mono text-[0.72rem] font-extrabold uppercase tracking-[0.14em]">File delivery for agents</p>
      <h2 class="mb-2 font-heading text-[clamp(1.3rem,2.4vw,1.85rem)] font-normal leading-[1.02] tracking-[-0.045em]">Move files with dlvr.sh.</h2>
      <p class="max-w-[720px] text-[0.9rem] leading-[1.5] opacity-75">Fast, secure, programmable file transfer for AI agents, scripts, and browsers.</p>
    </div>
    <span class="inline-flex items-center justify-center gap-2.5 border-2 border-white px-4 py-3 text-[0.9rem] font-bold">
      Visit dlvr.sh
      <Icon class="size-5 shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" name="heroicons:arrow-top-right-on-square" aria-hidden="true" />
    </span>
  </a>

</BaseLayout>

<script>
  const example = new URLSearchParams(window.location.search).get('example');
  const input = document.querySelector<HTMLInputElement>('#url');
  if (example && input) {
    input.value = example;
    input.focus();
  }
</script>

<script>
  interface WebMcpTool {
    name: string;
    description: string;
    inputSchema: Record<string, unknown>;
    execute: (input: { url: string; format?: 'json' | 'markdown' }) => Promise<unknown>;
    annotations: { readOnlyHint: boolean };
  }

  type AgentNavigator = Navigator & {
    modelContext?: { registerTool: (tool: WebMcpTool) => void };
  };

  const modelContext = (navigator as AgentNavigator).modelContext;
  if (modelContext) {
    modelContext.registerTool({
      name: 'extract_public_url',
      description: 'Extract one supported public URL as clean Markdown or normalized JSON.',
      inputSchema: {
        type: 'object',
        properties: {
          url: {
            type: 'string',
            format: 'uri',
            description: 'An absolute public HTTP or HTTPS page URL.',
          },
          format: {
            type: 'string',
            enum: ['json', 'markdown'],
            default: 'json',
          },
        },
        required: ['url'],
      },
      execute: async ({ url, format = 'json' }) => {
        const endpoint = new URL('/api/extract', window.location.origin);
        endpoint.searchParams.set('url', url);
        endpoint.searchParams.set('format', format);
        const response = await fetch(endpoint);
        if (!response.ok) return response.json();
        return format === 'markdown' ? response.text() : response.json();
      },
      annotations: { readOnlyHint: true },
    });
  }
</script>
