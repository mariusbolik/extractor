---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLanding from '../components/SocialLanding.astro';

export const prerender = true;
const title = 'Shopify products and catalogs to Markdown or JSON — extractor.sh';
const description = 'Extract public Shopify products, collections, and storefront catalogs into clean Markdown or normalized JSON.';
---

<BaseLayout {title} {description} path="/shopify/">
  <SocialLanding
    platform="Shopify"
    eyebrow="Shopify extractor"
    headline="Storefront data, ready to use."
    {description}
    outcome="Products and catalogs in one consistent format."
    capabilities={[
      { label: 'Input', value: 'One public Shopify product, collection, or storefront URL.' },
      { label: 'Returns', value: 'One product entity or a feed containing up to 50 product entities.' },
      { label: 'Includes', value: 'Product titles, descriptions, prices, variants, images, and canonical links when available.' },
      { label: 'Caching', value: 'Successful catalog feeds may be cached at Cloudflare’s edge for up to one hour.' },
    ]}
    supported={[
      'Public storefront product pages',
      'Public collection pages',
      'Public storefront homepages',
    ]}
    limitations={[
      'Catalog feeds contain up to 50 products',
      'Protected or disabled storefront data may be unavailable',
      'No carts, customer accounts, checkout data, or order history',
    ]}
    exampleUrl="https://www.allbirds.com/products/mens-cruiser-shadow-blue-natural-white-sole"
  />
</BaseLayout>
