---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CURRENT_YEAR, platformArticles } from '../../features/marketing/content';

export const prerender = true;
const title = `Web extraction and search APIs for AI — extractor.sh blog ${CURRENT_YEAR}`;
const description = `Practical ${CURRENT_YEAR} guides to public web extraction, search APIs, MCP tools, AI-ready Markdown, and normalized JSON.`;
const keywords = ['web scraping for AI', 'web search API', 'AI data extraction', 'RAG web data', 'MCP web search', 'LLM-ready Markdown'];
---

<BaseLayout {title} {description} {keywords} path="/blog/">
  <section class="pb-8">
    <p class="mb-4 font-mono text-[0.8rem] font-extrabold uppercase tracking-[0.14em]">extractor.sh blog</p>
    <h1 class="mb-5 max-w-[900px] font-heading text-[clamp(2.3rem,5.5vw,4.8rem)] font-normal leading-[1.02] tracking-[-0.045em]">Public web data for AI, without the noise.</h1>
    <p class="mb-0 max-w-[740px] text-[clamp(1.05rem,2vw,1.28rem)] leading-[1.65]">Practical guides for extracting public pages, searching the web, and giving AI agents source-linked Markdown or normalized JSON.</p>
  </section>

  <section class="mt-8 grid grid-cols-2 gap-5 max-[760px]:grid-cols-1" aria-label="Web data guides">
    {platformArticles.map((article) => (
      <a class="group flex min-h-[230px] flex-col border-2 border-black bg-white p-6 no-underline transition duration-100 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[6px_6px_0_#000] hover:no-underline" href={`/blog/${article.slug}/`}>
        <p class="mb-5 font-mono text-[0.74rem] font-extrabold uppercase tracking-[0.12em]">Guide / {CURRENT_YEAR}</p>
        <h2 class="mb-4 font-heading text-[1.25rem] font-normal leading-[1.1] tracking-[-0.035em]">{article.headline ?? `How to scrape data from ${article.platform} in ${CURRENT_YEAR}`}</h2>
        <p class="mb-0 leading-relaxed">{article.description}</p>
        <span class="mt-auto block pt-8" aria-hidden="true"><Icon class="size-6 transition-transform group-hover:translate-x-1" name="heroicons:arrow-right" /></span>
      </a>
    ))}
  </section>
</BaseLayout>
