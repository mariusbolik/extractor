---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { alternativePages } from '../../features/marketing/content';

export const prerender = true;
const title = 'Web scraping and search API alternatives for AI — extractor.sh';
const description = 'Compare extractor.sh with web scraping, search, browser, crawling, and extraction providers for AI agents and RAG pipelines.';
const keywords = ['web scraping API alternatives', 'AI search API alternatives', 'AI scraping API', 'RAG extraction API', 'URL to Markdown API'];
---

<BaseLayout {title} {description} {keywords} path="/alternatives/">
  <section class="pb-8">
    <p class="mb-4 font-mono text-[0.8rem] font-extrabold uppercase tracking-[0.14em]">Alternatives</p>
    <h1 class="mb-5 max-w-[900px] font-heading text-[clamp(2.3rem,5.5vw,4.8rem)] font-normal leading-[1.02] tracking-[-0.045em]">Choose the smallest tool that fits.</h1>
    <p class="mb-0 max-w-[760px] text-[clamp(1.05rem,2vw,1.28rem)] leading-[1.65]">extractor.sh is intentionally focused: public-page extraction plus web, news, image, and place search. Compare it with broader search, proxy, browser, crawling, and automation platforms.</p>
  </section>

  <section class="mt-8 grid grid-cols-2 gap-5 max-[760px]:grid-cols-1" aria-label="Provider comparisons">
    {alternativePages.map((alternative) => (
      <a class="group flex min-h-[220px] flex-col border-2 border-black bg-white p-6 no-underline transition duration-100 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[6px_6px_0_#000] hover:no-underline" href={`/alternatives/${alternative.slug}/`}>
        <p class="mb-5 font-mono text-[0.74rem] font-extrabold uppercase tracking-[0.12em]">Comparison</p>
        <h2 class="mb-4 font-heading text-[1.25rem] font-normal leading-[1.1] tracking-[-0.035em]">extractor.sh vs. {alternative.provider}</h2>
        <p class="mb-0 leading-relaxed">{alternative.description}</p>
        <span class="mt-auto block pt-8" aria-hidden="true"><Icon class="size-6 transition-transform group-hover:translate-x-1" name="heroicons:arrow-right" /></span>
      </a>
    ))}
  </section>
</BaseLayout>
