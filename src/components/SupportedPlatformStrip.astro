---
import { supportedPlatforms } from '../features/marketing/platforms';
import PlatformIcon from './PlatformIcon.astro';
---

<div id="works-with" class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-4 border-t-2 border-black pt-5">
  <p class="m-0 shrink-0 font-mono text-[0.76rem] font-extrabold uppercase tracking-[0.12em]">Works with:</p>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-3" aria-label="Supported platforms">
    {supportedPlatforms.map((platform) => (
      <a class="inline-flex text-black transition-transform duration-100 hover:-translate-y-0.5" href={platform.href} aria-label={platform.name} title={platform.name}>
        <PlatformIcon {...platform} class="size-5 shrink-0" idSuffix="works" />
      </a>
    ))}
  </div>
</div>
