---
import { Icon } from 'astro-icon/components';
---

<section class="mb-12 border-2 border-black bg-white shadow-[10px_10px_0_#000] max-[660px]:shadow-[6px_6px_0_#000]" aria-label="Web extraction, search, and finance">
  <div class="grid lg:grid-cols-[218px_minmax(0,1fr)]">
    <aside class="border-b-2 border-black bg-white p-3 text-black lg:border-r-2 lg:border-b-0" aria-label="Live API examples">
      <div class="px-2 pt-2 pb-4">
        <p class="mb-2 font-mono text-[0.7rem] font-extrabold uppercase tracking-[0.14em] text-black/60">Live examples</p>
        <p class="text-[0.82rem] leading-[1.5] text-black/70">Choose a capability. Its example runs instantly.</p>
      </div>
      <div class="grid gap-2 max-lg:grid-cols-2 max-[520px]:grid-cols-1" aria-label="Choose an action">
        <button class="group inline-flex min-h-[50px] w-full items-center gap-3 border-2 border-black bg-white px-3 py-2.5 text-left text-[0.85rem] font-extrabold text-black aria-pressed:bg-black aria-pressed:text-white" type="button" data-form-mode="search" aria-pressed="true">
          <Icon class="size-[18px] shrink-0" name="heroicons:magnifying-glass" aria-hidden="true" /> <span class="flex-1">Web Search</span><Icon class="size-4 shrink-0 opacity-0 group-aria-pressed:opacity-100" name="heroicons:arrow-right" aria-hidden="true" />
        </button>
        <button class="group inline-flex min-h-[50px] w-full items-center gap-3 border-2 border-black bg-white px-3 py-2.5 text-left text-[0.85rem] font-extrabold text-black aria-pressed:bg-black aria-pressed:text-white" type="button" data-form-mode="extract" aria-pressed="false">
          <Icon class="size-[18px] shrink-0" name="heroicons:link" aria-hidden="true" /> <span class="flex-1">Extract</span><Icon class="size-4 shrink-0 opacity-0 group-aria-pressed:opacity-100" name="heroicons:arrow-right" aria-hidden="true" />
        </button>
        <button class="group inline-flex min-h-[50px] w-full items-center gap-3 border-2 border-black bg-white px-3 py-2.5 text-left text-[0.85rem] font-extrabold text-black aria-pressed:bg-black aria-pressed:text-white" type="button" data-form-mode="news" aria-pressed="false">
          <Icon class="size-[18px] shrink-0" name="heroicons:newspaper" aria-hidden="true" /> <span class="flex-1">News</span><Icon class="size-4 shrink-0 opacity-0 group-aria-pressed:opacity-100" name="heroicons:arrow-right" aria-hidden="true" />
        </button>
        <button class="group inline-flex min-h-[50px] w-full items-center gap-3 border-2 border-black bg-white px-3 py-2.5 text-left text-[0.85rem] font-extrabold text-black aria-pressed:bg-black aria-pressed:text-white" type="button" data-form-mode="images" aria-pressed="false">
          <Icon class="size-[18px] shrink-0" name="heroicons:photo" aria-hidden="true" /> <span class="flex-1">Images</span><Icon class="size-4 shrink-0 opacity-0 group-aria-pressed:opacity-100" name="heroicons:arrow-right" aria-hidden="true" />
        </button>
        <button class="group inline-flex min-h-[50px] w-full items-center gap-3 border-2 border-black bg-white px-3 py-2.5 text-left text-[0.85rem] font-extrabold text-black aria-pressed:bg-black aria-pressed:text-white" type="button" data-form-mode="videos" aria-pressed="false">
          <Icon class="size-[18px] shrink-0" name="heroicons:video-camera" aria-hidden="true" /> <span class="flex-1">Videos</span><Icon class="size-4 shrink-0 opacity-0 group-aria-pressed:opacity-100" name="heroicons:arrow-right" aria-hidden="true" />
        </button>
        <button class="group inline-flex min-h-[50px] w-full items-center gap-3 border-2 border-black bg-white px-3 py-2.5 text-left text-[0.85rem] font-extrabold text-black aria-pressed:bg-black aria-pressed:text-white" type="button" data-form-mode="places" aria-pressed="false">
          <Icon class="size-[18px] shrink-0" name="heroicons:map-pin" aria-hidden="true" /> <span class="flex-1">Places</span><Icon class="size-4 shrink-0 opacity-0 group-aria-pressed:opacity-100" name="heroicons:arrow-right" aria-hidden="true" />
        </button>
        <button class="group inline-flex min-h-[50px] w-full items-center gap-3 border-2 border-black bg-white px-3 py-2.5 text-left text-[0.85rem] font-extrabold text-black aria-pressed:bg-black aria-pressed:text-white" type="button" data-form-mode="finance" aria-pressed="false">
          <Icon class="size-[18px] shrink-0" name="heroicons:chart-bar" aria-hidden="true" /> <span class="flex-1">Finance</span><Icon class="size-4 shrink-0 opacity-0 group-aria-pressed:opacity-100" name="heroicons:arrow-right" aria-hidden="true" />
        </button>
      </div>
    </aside>

    <div class="min-w-0 p-[clamp(20px,3.5vw,38px)]">
      <form id="extract-form" action="/api/search" method="get">
        <div>
          <p class="mb-1 font-mono text-[0.7rem] font-extrabold uppercase tracking-[0.14em]">Try your own data</p>
          <label id="form-input-label" class="text-[0.88rem] font-extrabold" for="url">Search query</label>
        </div>
        <div class="mt-[9px] grid grid-cols-[1fr_auto] gap-[12px] max-[660px]:grid-cols-1">
          <input class="min-h-[52px] min-w-0 border-2 border-black bg-white px-[15px] py-3 text-black outline-none placeholder:text-black/50 focus:outline-none focus-visible:!outline-none" id="url" name="q" type="text" inputmode="search" autocomplete="off" required maxlength="200" value="the white house" placeholder="the white house" />
          <button class="inline-flex min-h-[52px] cursor-pointer items-center justify-center gap-[9px] border-[2px_5px_5px_2px] border-black bg-white px-[20px] py-[10px] font-[850] transition-[transform,border-width] duration-100 hover:translate-x-[2px] hover:translate-y-[2px] hover:border-[4px_3px_3px_4px] active:translate-x-[3px] active:translate-y-[3px] active:border-[5px_2px_2px_5px] max-[660px]:w-full" type="submit"><span id="form-submit-label">Search</span> <Icon class="size-[19px] shrink-0" name="heroicons:arrow-right" aria-hidden="true" /></button>
        </div>
        <div class="mt-5 flex flex-col gap-4 border-t-2 border-black pt-4 sm:flex-row sm:items-start" id="form-options">
          <fieldset class="m-0 shrink-0 border-0 p-0">
            <legend class="text-[0.82rem] font-extrabold">Output format</legend>
            <div class="mt-2 inline-flex border-2 border-black">
              <label class="cursor-pointer"><input class="peer sr-only" type="radio" name="format" value="markdown" checked /><span class="inline-flex min-h-10 items-center bg-white px-3 text-[0.78rem] font-extrabold peer-checked:bg-black peer-checked:text-white peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-black">Markdown</span></label>
              <label class="cursor-pointer border-l-2 border-black"><input class="peer sr-only" type="radio" name="format" value="json" /><span class="inline-flex min-h-10 items-center bg-white px-3 text-[0.78rem] font-extrabold peer-checked:bg-black peer-checked:text-white peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-black">JSON</span></label>
            </div>
          </fieldset>
          <div class="grid min-w-0 flex-1 gap-4 sm:grid-cols-2">
        <div data-options-mode="extract" hidden>
          <label class="text-[0.82rem] font-extrabold" for="extract-focus">Focus topic</label>
          <input class="mt-2 min-h-11 w-full border-2 border-black px-3 py-2" id="extract-focus" name="focus" type="text" maxlength="80" placeholder="pricing, features, FAQ" />
        </div>
        <div data-options-mode="search news videos">
          <label class="text-[0.82rem] font-extrabold" for="search-locale">Language and country</label>
          <select class="mt-2 min-h-11 w-full border-2 border-black bg-white px-3 py-2" id="search-locale" data-locale-preset disabled>
            <option value="en-US|US">English · United States</option>
            <option value="en-GB|GB">English · United Kingdom</option>
            <option value="de-DE|DE">Deutsch · Deutschland</option>
            <option value="fr-FR|FR">Français · France</option>
            <option value="es-ES|ES">Español · España</option>
            <option value="ja-JP|JP">日本語 · 日本</option>
          </select>
          <input name="language" value="en-US" type="hidden" data-locale-language disabled />
          <input name="country" value="US" type="hidden" data-locale-country disabled />
        </div>
        <div data-options-mode="videos" hidden>
          <label class="text-[0.82rem] font-extrabold" for="video-creator">Exact creator (optional)</label>
          <input class="mt-2 min-h-11 w-full border-2 border-black px-3 py-2" id="video-creator" name="creator" type="text" maxlength="80" placeholder="Taylor Swift" disabled />
          <label class="mt-3 block text-[0.82rem] font-extrabold" for="video-platform">Video source</label>
          <select class="mt-2 min-h-11 w-full border-2 border-black bg-white px-3 py-2" id="video-platform" name="platform" disabled>
            <option value="any">Any supported source</option>
            <option value="youtube">YouTube</option>
          </select>
          <label class="mt-3 block text-[0.82rem] font-extrabold" for="video-sort">Order</label>
          <select class="mt-2 min-h-11 w-full border-2 border-black bg-white px-3 py-2" id="video-sort" name="sort" disabled>
            <option value="relevance">Most relevant</option>
            <option value="date">Newest first</option>
          </select>
        </div>
        <div data-options-mode="search" hidden>
          <label class="text-[0.82rem] font-extrabold" for="search-site">Only this site (optional)</label>
          <input class="mt-2 min-h-11 w-full border-2 border-black px-3 py-2" id="search-site" name="site" type="text" maxlength="253" placeholder="linkedin.com" disabled />
        </div>
        <div data-options-mode="news" hidden>
          <label class="text-[0.82rem] font-extrabold" for="news-timeframe">Published within</label>
          <select class="mt-2 min-h-11 w-full border-2 border-black bg-white px-3 py-2" id="news-timeframe" name="timeframe" disabled>
            <option value="any">Any time</option><option value="1h">1 hour</option><option value="1d">1 day</option><option value="7d">7 days</option><option value="30d">30 days</option>
          </select>
        </div>
        <div data-options-mode="images" hidden>
          <label class="text-[0.82rem] font-extrabold" for="image-usage">Usage rights</label>
          <select class="mt-2 min-h-11 w-full border-2 border-black bg-white px-3 py-2" id="image-usage" name="usage" disabled>
            <option value="all">All open licenses</option><option value="commercial">Commercial use</option><option value="modify">Modifications allowed</option><option value="commercial-and-modify">Commercial + modify</option>
          </select>
          <label class="mt-3 block text-[0.82rem] font-extrabold" for="image-orientation">Orientation</label>
          <select class="mt-2 min-h-11 w-full border-2 border-black bg-white px-3 py-2" id="image-orientation" name="orientation" disabled>
            <option value="any">Any</option><option value="landscape">Landscape</option><option value="portrait">Portrait</option><option value="square">Square</option>
          </select>
        </div>
        <div class="sm:col-span-2" data-options-mode="places" hidden>
          <div class="grid gap-4 sm:grid-cols-3">
            <label class="text-[0.82rem] font-extrabold">Language<input class="mt-2 min-h-11 w-full border-2 border-black px-3 py-2" name="language" value="en" maxlength="35" disabled /></label>
            <label class="text-[0.82rem] font-extrabold">Country filter<input class="mt-2 min-h-11 w-full border-2 border-black px-3 py-2 uppercase" name="country" maxlength="2" placeholder="DE" disabled /></label>
            <label class="text-[0.82rem] font-extrabold">Place type<select class="mt-2 min-h-11 w-full border-2 border-black bg-white px-3 py-2" name="type" disabled><option value="any">Any</option><option value="house">House</option><option value="street">Street</option><option value="locality">Locality</option><option value="city">City</option><option value="county">County</option><option value="state">State</option><option value="country">Country</option><option value="other">Other</option></select></label>
          </div>
          <p class="mt-4 mb-2 text-[0.82rem] font-extrabold">Nearby bias (optional pair)</p>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="text-[0.8rem]">Latitude<input class="mt-2 min-h-11 w-full border-2 border-black px-3 py-2" name="lat" type="number" min="-90" max="90" step="any" placeholder="52.52" disabled /></label>
            <label class="text-[0.8rem]">Longitude<input class="mt-2 min-h-11 w-full border-2 border-black px-3 py-2" name="lon" type="number" min="-180" max="180" step="any" placeholder="13.405" disabled /></label>
          </div>
        </div>
        <div data-options-mode="finance" hidden>
          <label class="text-[0.82rem] font-extrabold" for="finance-timeframe">History timeframe</label>
          <select class="mt-2 min-h-11 w-full border-2 border-black bg-white px-3 py-2" id="finance-timeframe" name="timeframe" disabled>
            <option value="1d">1 day</option><option value="5d">5 days</option><option value="1mo" selected>1 month</option><option value="3mo">3 months</option><option value="6mo">6 months</option><option value="1y">1 year</option><option value="5y">5 years</option><option value="max">Maximum</option>
          </select>
          <label class="mt-3 block text-[0.82rem] font-extrabold" for="finance-quote">Output currency</label>
          <select class="mt-2 min-h-11 w-full border-2 border-black bg-white px-3 py-2" id="finance-quote" name="quote" disabled>
            <option value="">Native listing currency</option><option value="EUR">EUR</option><option value="USD">USD</option><option value="GBP">GBP</option><option value="JPY">JPY</option><option value="CHF">CHF</option><option value="CAD">CAD</option><option value="AUD">AUD</option>
          </select>
        </div>
          </div>
        </div>
      </form>

      <div id="result" class="result mt-6 border-t-2 border-black pt-5 data-[state=error]:[&_.result-content]:border-dashed" data-state="loading" aria-live="polite" aria-busy="true">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span id="result-label" class="font-mono text-[0.75rem] font-extrabold uppercase tracking-[0.14em]">Searching…</span>
          <div class="flex items-center gap-4 text-[0.82rem] font-extrabold">
            <button id="copy-result" class="inline-flex cursor-pointer items-center gap-[5px] border-0 bg-white p-0 font-extrabold underline underline-offset-[0.2em]" type="button"><Icon class="size-[18px] shrink-0" name="heroicons:clipboard-document" aria-hidden="true" /> <span>Copy</span></button>
            <a class="inline-flex items-center gap-[5px]" id="raw-result" target="_blank" rel="noopener">Open raw <Icon class="size-[18px] shrink-0" name="heroicons:arrow-top-right-on-square" aria-hidden="true" /></a>
          </div>
        </div>
        <div id="result-content" class="result-content mt-3 h-[min(52vh,520px)] min-h-[300px] overflow-auto border-2 border-black bg-black p-[clamp(16px,2.5vw,26px)] font-mono text-[0.82rem] leading-[1.65] text-white [&_.shiki]:!bg-black [&_pre]:m-0 [&_pre]:min-w-max [&_pre]:rounded-[3px] [&_pre]:!bg-black [&_pre]:text-white [&_pre]:whitespace-pre">
          <p class="animate-pulse">Loading. Please wait.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#extract-form');
  const result = document.querySelector<HTMLElement>('#result');
  const resultLabel = document.querySelector<HTMLElement>('#result-label');
  const resultContent = document.querySelector<HTMLElement>('#result-content');
  const rawResult = document.querySelector<HTMLAnchorElement>('#raw-result');
  const copyResult = document.querySelector<HTMLButtonElement>('#copy-result');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = document.querySelector<HTMLElement>('#form-submit-label');
  const input = document.querySelector<HTMLInputElement>('#url');
  const inputLabel = document.querySelector<HTMLLabelElement>('#form-input-label');
  const modeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-form-mode]')];
  const modeOptionGroups = [...document.querySelectorAll<HTMLElement>('[data-options-mode]')];
  const localePreset = document.querySelector('[data-locale-preset]') as (HTMLElement & { value: string }) | null;
  let jsonHighlighter: ReturnType<typeof createJsonHighlighter> | undefined;
  let copyValue = '';

  type FormMode = 'extract' | 'search' | 'news' | 'images' | 'videos' | 'places' | 'finance';
  const modes = {
    extract: {
      action: '/api/extract',
      example: 'https://blog.hubspot.com/marketing/loop-marketing',
      inputName: 'url',
      inputType: 'url',
      inputMode: 'url',
      autocomplete: 'url',
      maximumLength: 2_048,
      label: 'Website URL',
      placeholder: 'https://www.amazon.com/dp/B09B8V1LZ3',
      submit: 'Extract',
      loading: 'Extracting…',
      errorLabel: 'Could not extract',
      errorMessage: 'Extraction failed.',
    },
    search: {
      action: '/api/search',
      example: 'the white house',
      inputName: 'q',
      inputType: 'text',
      inputMode: 'search',
      autocomplete: 'off',
      maximumLength: 200,
      label: 'Search query',
      placeholder: 'the white house',
      submit: 'Search',
      loading: 'Searching…',
      errorLabel: 'Could not search',
      errorMessage: 'Search failed.',
    },
    news: {
      action: '/api/news',
      example: 'elon musk',
      inputName: 'q',
      inputType: 'text',
      inputMode: 'search',
      autocomplete: 'off',
      maximumLength: 200,
      label: 'News query',
      placeholder: 'elon musk',
      submit: 'Search news',
      loading: 'Searching news…',
      errorLabel: 'Could not search news',
      errorMessage: 'News search failed.',
    },
    images: {
      action: '/api/images',
      example: 'humanoid robot',
      inputName: 'q',
      inputType: 'text',
      inputMode: 'search',
      autocomplete: 'off',
      maximumLength: 200,
      label: 'Image query',
      placeholder: 'humanoid robot',
      submit: 'Search images',
      loading: 'Searching images…',
      errorLabel: 'Could not search images',
      errorMessage: 'Image search failed.',
    },
    videos: {
      action: '/api/videos',
      example: 'Claude Code tutorial',
      inputName: 'q',
      inputType: 'text',
      inputMode: 'search',
      autocomplete: 'off',
      maximumLength: 200,
      label: 'Video query',
      placeholder: 'Claude Code tutorial',
      submit: 'Search videos',
      loading: 'Searching videos…',
      errorLabel: 'Could not search videos',
      errorMessage: 'Video search failed.',
    },
    places: {
      action: '/api/places',
      example: 'Computer History Museum',
      inputName: 'q',
      inputType: 'text',
      inputMode: 'search',
      autocomplete: 'off',
      maximumLength: 200,
      label: 'Place or address',
      placeholder: 'Computer History Museum',
      submit: 'Search places',
      loading: 'Searching places…',
      errorLabel: 'Could not search places',
      errorMessage: 'Place search failed.',
    },
    finance: {
      action: '/api/finance',
      example: 'NVDA',
      inputName: 'symbol',
      inputType: 'text',
      inputMode: 'text',
      autocomplete: 'off',
      maximumLength: 32,
      label: 'Market symbol',
      placeholder: 'AAPL, ^GSPC, BTC-USD, EURUSD=X',
      submit: 'Get market data',
      loading: 'Loading market data…',
      errorLabel: 'Could not load market data',
      errorMessage: 'Market data request failed.',
    },
  } as const;
  let mode: FormMode = 'search';
  let activeRequest: AbortController | undefined;
  let requestId = 0;

  /**
   * Reconfigure the single public input instead of maintaining two forms.
   * This keeps the interaction compact and guarantees that only the parameter
   * accepted by the selected GET endpoint is submitted.
   */
  function selectMode(nextMode: FormMode, runExample = true, example?: string) {
    if (!form || !input || !inputLabel || !submitLabel) return;
    mode = nextMode;
    const config = modes[mode];
    form.action = config.action;
    input.name = config.inputName;
    input.type = config.inputType;
    input.inputMode = config.inputMode;
    input.setAttribute('autocomplete', config.autocomplete);
    input.maxLength = config.maximumLength;
    input.placeholder = config.placeholder;
    input.value = example ?? config.example;
    inputLabel.textContent = config.label;
    submitLabel.textContent = config.submit;
    modeButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.formMode === mode));
    });
    modeOptionGroups.forEach((group) => {
      const active = (group.dataset.optionsMode ?? '').split(' ').includes(mode);
      group.hidden = !active;
      group.querySelectorAll('input, select').forEach((control) => {
        (control as HTMLElement & { disabled: boolean }).disabled = !active;
      });
    });
    copyValue = '';
    if (runExample) form.requestSubmit();
  }

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => selectMode(button.dataset.formMode as FormMode));
  });

  localePreset?.addEventListener('change', () => {
    const [language, country] = localePreset.value.split('|');
    const languageInput = form?.querySelector<HTMLInputElement>('[data-locale-language]');
    const countryInput = form?.querySelector<HTMLInputElement>('[data-locale-country]');
    if (languageInput && language) languageInput.value = language;
    if (countryInput && country) countryInput.value = country;
  });

  // Shiki is only needed after a successful JSON request. Keeping its single
  // grammar and light theme in a lazy chunk avoids slowing the initial form.
  async function createJsonHighlighter() {
    const [{ createHighlighterCore }, { createJavaScriptRegexEngine }, { default: json }, { default: githubDark }] = await Promise.all([
      import('shiki/core'),
      import('shiki/engine/javascript'),
      import('shiki/langs/json.mjs'),
      import('shiki/themes/github-dark-default.mjs'),
    ]);
    return createHighlighterCore({
      themes: [githubDark],
      langs: [json],
      engine: createJavaScriptRegexEngine(),
    });
  }

  function getJsonHighlighter() {
    jsonHighlighter ??= createJsonHighlighter();
    return jsonHighlighter;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !result || !resultContent || !resultLabel || !rawResult || !submit) return;

    const requestedMode = mode;
    const config = modes[requestedMode];
    const endpoint = new URL(form.action, window.location.origin);
    endpoint.search = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
    for (const [key, value] of [...endpoint.searchParams]) {
      if (!value) endpoint.searchParams.delete(key);
    }
    const format = endpoint.searchParams.get('format') || 'json';
    const currentRequestId = ++requestId;
    activeRequest?.abort();
    activeRequest = new AbortController();

    result.dataset.state = 'loading';
    result.setAttribute('aria-busy', 'true');
    resultLabel.textContent = config.loading;
    const loading = document.createElement('p');
    loading.className = 'animate-pulse';
    loading.textContent = 'Loading. Please wait.';
    resultContent.replaceChildren(loading);
    rawResult.href = endpoint.toString();

    try {
      const response = await fetch(endpoint, {
        credentials: 'same-origin',
        headers: { 'X-Extractor-Web-Client': '1' },
        signal: activeRequest.signal,
      });
      if (currentRequestId !== requestId) return;
      if (!response.ok) {
        const payload = await response.json().catch(() => ({ error: { message: config.errorMessage } })) as {
          error?: { message?: string };
        };
        throw new Error(payload.error?.message || config.errorMessage);
      }

      if (format === 'json') {
        const payload = await response.json();
        if (currentRequestId !== requestId) return;
        copyValue = JSON.stringify(payload, null, 2);
        const highlighter = await getJsonHighlighter();
        if (currentRequestId !== requestId) return;
        resultContent.innerHTML = highlighter.codeToHtml(copyValue, {
          lang: 'json',
          theme: 'github-dark-default',
        });
        resultLabel.textContent = 'JSON result';
      } else {
        copyValue = await response.text();
        if (currentRequestId !== requestId) return;
        const pre = document.createElement('pre');
        pre.textContent = copyValue;
        resultContent.replaceChildren(pre);
        resultLabel.textContent = 'Raw Markdown result';
      }
      result.dataset.state = 'success';
    } catch (error) {
      if (error instanceof DOMException && error.name === 'AbortError') return;
      if (currentRequestId !== requestId) return;
      copyValue = '';
      result.dataset.state = 'error';
      resultLabel.textContent = config.errorLabel;
      const message = document.createElement('p');
      message.textContent = error instanceof Error ? error.message : config.errorMessage;
      resultContent.replaceChildren(message);
    } finally {
      if (currentRequestId === requestId) result.setAttribute('aria-busy', 'false');
    }
  });

  form?.querySelectorAll<HTMLInputElement>('input[name="format"]').forEach((formatInput) => {
    formatInput.addEventListener('change', () => form.requestSubmit());
  });

  copyResult?.addEventListener('click', async () => {
    if (!copyValue || !copyResult) return;
    await navigator.clipboard.writeText(copyValue);
    const label = copyResult.querySelector('span');
    if (label) label.textContent = 'Copied';
    window.setTimeout(() => { if (label) label.textContent = 'Copy'; }, 1_500);
  });

  const linkedExample = new URLSearchParams(window.location.search).get('example');
  selectMode(linkedExample ? 'extract' : 'search', false, linkedExample ?? undefined);
  form?.requestSubmit();
</script>
