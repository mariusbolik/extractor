---
import SecurityCheckAnimation from './SecurityCheckAnimation.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="flex flex-col items-center text-center">
  <SecurityCheckAnimation class="h-auto w-[clamp(70px,14vw,95px)]" />
  <p id={id} class="font-mono text-[0.76rem] font-bold uppercase tracking-[0.08em]" role="status" aria-live="polite" data-security-check-status>Running security check...</p>
</div>
