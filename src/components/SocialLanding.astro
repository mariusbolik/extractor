---
import { Icon } from 'astro-icon/components';
import { platformFaq, platformPages, type PlatformPageConfig } from '../features/marketing/platform-pages';
import PlatformIcon from './PlatformIcon.astro';
import PlatformPlayground from './PlatformPlayground.astro';
import FinancePlayground from './FinancePlayground.astro';

interface Props {
  page: PlatformPageConfig;
}

const { page } = Astro.props;
const exampleUrl = page.capabilities.find((capability) => capability.exampleUrl)?.exampleUrl ?? '';
const related = page.related.map((slug) => platformPages[slug]).filter(Boolean);
const faq = platformFaq(page);
const financePage = page.slug === 'yahoo-finance';
const curlExample = financePage ? `curl --get 'https://extractor.sh/api/finance' \\
  --data-urlencode 'symbol=AAPL' \\
  --data-urlencode 'timeframe=1mo' \\
  --data-urlencode 'format=json'` : `curl --get 'https://extractor.sh/api/extract' \\
  --data-urlencode 'url=${exampleUrl}' \\
  --data-urlencode 'format=json'`;
const nodeExample = financePage ? `const params = new URLSearchParams({
  symbol: 'AAPL',
  timeframe: '1mo',
  format: 'json',
});

const response = await fetch(
  \`https://extractor.sh/api/finance?\${params}\`,
);
const data = await response.json();` : `const params = new URLSearchParams({
  url: '${exampleUrl}',
  format: 'json',
});

const response = await fetch(
  \`https://extractor.sh/api/extract?\${params}\`,
);
const data = await response.json();`;
const pythonExample = financePage ? `from json import load
from urllib.parse import urlencode
from urllib.request import urlopen

params = urlencode({
    "symbol": "AAPL",
    "timeframe": "1mo",
    "format": "json",
})

with urlopen(f"https://extractor.sh/api/finance?{params}") as response:
    data = load(response)` : `from json import load
from urllib.parse import urlencode
from urllib.request import urlopen

params = urlencode({
    "url": "${exampleUrl}",
    "format": "json",
})

with urlopen(f"https://extractor.sh/api/extract?{params}") as response:
    data = load(response)`;
const codeExamples = [
  { id: 'curl', label: 'curl', code: curlExample },
  { id: 'node', label: 'Node', code: nodeExample },
  { id: 'python', label: 'Python', code: pythonExample },
];
---

<nav class="mb-8 font-mono text-[0.76rem] font-bold" aria-label="Breadcrumb">
  <ol class="flex list-none items-center gap-2 p-0">
    <li><a class="underline underline-offset-4" href="/">extractor.sh</a></li>
    <li aria-hidden="true">/</li>
    <li aria-current="page">{page.platform} scraper</li>
  </ol>
</nav>

<section class="grid grid-cols-[minmax(0,1.25fr)_minmax(330px,0.75fr)] items-start gap-[clamp(34px,6vw,72px)] max-[840px]:grid-cols-1" aria-labelledby="platform-title">
  <div class="pt-3">
    <p class="mb-4 inline-flex items-center gap-3 font-mono text-[0.78rem] font-extrabold uppercase tracking-[0.14em]">
      <PlatformIcon name={page.platform} icon={page.icon} brandIcon={page.brandIcon} class="size-7 shrink-0" idSuffix={`${page.slug}-hero`} />
      {page.eyebrow}
    </p>
    <h1 class="mb-5 max-w-[820px] font-heading text-[clamp(2.15rem,5.1vw,4rem)] font-normal leading-[1.02] tracking-[-0.045em]" id="platform-title">{page.headline}</h1>
    <p class="mb-7 max-w-[720px] text-[clamp(1.02rem,1.8vw,1.2rem)] leading-[1.6]">{page.description}</p>
    <div class="flex flex-wrap items-center gap-5">
      <a class="inline-flex items-center gap-2 border-[2px_5px_5px_2px] border-black bg-white px-5 py-3 font-extrabold no-underline transition-[transform,border-width] duration-100 hover:translate-x-[2px] hover:translate-y-[2px] hover:border-[4px_3px_3px_4px]" href="#playground">Try it free <Icon class="size-5" name="heroicons:arrow-down" aria-hidden="true" /></a>
      <span class="font-mono text-[0.75rem] font-extrabold uppercase tracking-[0.1em]">No account needed</span>
    </div>
  </div>

  <aside class="border-2 border-black bg-white shadow-[8px_8px_0_#000]" aria-labelledby="capabilities-heading" data-capability-card>
    <div class="border-b-2 border-black bg-black px-5 py-4 text-white">
      <p class="font-mono text-[0.72rem] font-extrabold uppercase tracking-[0.14em]">Capabilities</p>
      <h2 class="mt-2 font-heading text-[1.45rem] font-normal leading-[1.08] tracking-[-0.035em]" id="capabilities-heading">What you can extract</h2>
    </div>
    <ul class="list-none p-0">
      {page.capabilities.map((capability) => (
        <li class="grid grid-cols-[20px_1fr] gap-3 border-b-2 border-black p-5 last:border-b-0">
          <Icon class="mt-0.5 size-5" name="heroicons:check" aria-hidden="true" />
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <strong class="font-extrabold">{capability.name}</strong>
              <span class="font-mono text-[0.66rem] font-extrabold uppercase tracking-[0.1em]">{capability.output}</span>
            </div>
            <p class="mt-2 text-[0.88rem] leading-[1.55]">{capability.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </aside>
</section>

<div id="playground">
  {financePage
    ? <FinancePlayground />
    : <PlatformPlayground platform={page.platform} capabilities={page.capabilities} />}
</div>

<section class="mt-8 grid grid-cols-2 gap-6 max-[760px]:grid-cols-1" aria-label={`${page.platform} extraction details`}>
  <div class="border-2 border-black bg-white p-[clamp(22px,4vw,38px)]">
    <p class="mb-3 font-mono text-[0.74rem] font-extrabold uppercase tracking-[0.14em]">Supported inputs</p>
    <h2 class="mb-5 font-heading text-[clamp(1.45rem,2.5vw,2rem)] font-normal leading-[1.06] tracking-[-0.04em]">Built for normal public URLs.</h2>
    <ul class="list-[square] space-y-3 pl-5 leading-[1.55]">
      {page.includes.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  <div class="border-2 border-black bg-white p-[clamp(22px,4vw,38px)]">
    <p class="mb-3 font-mono text-[0.74rem] font-extrabold uppercase tracking-[0.14em]">Clear boundaries</p>
    <h2 class="mb-5 font-heading text-[clamp(1.45rem,2.5vw,2rem)] font-normal leading-[1.06] tracking-[-0.04em]">Know exactly what to expect.</h2>
    <ul class="list-[square] space-y-3 pl-5 leading-[1.55]">
      {page.limitations.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<section class="mt-8 border-2 border-black bg-white" aria-labelledby="code-heading">
  <div class="grid grid-cols-[0.7fr_1.3fr] max-[800px]:grid-cols-1">
    <div class="border-r-2 border-black p-[clamp(22px,4vw,42px)] max-[800px]:border-r-0 max-[800px]:border-b-2">
      <p class="mb-3 font-mono text-[0.74rem] font-extrabold uppercase tracking-[0.14em]">One GET request</p>
      <h2 class="mb-4 font-heading text-[clamp(1.55rem,3vw,2.25rem)] font-normal leading-[1.05] tracking-[-0.04em]" id="code-heading">Add {page.platform} data to your agent.</h2>
      <p class="leading-[1.65]">No SDK and no account are required during the public preview. Choose JSON for typed entities or Markdown for direct model context.</p>
      <a class="mt-6 inline-flex items-center gap-2 font-extrabold underline underline-offset-4" href="/docs/quickstart/">Read the quickstart <Icon class="size-[18px]" name="heroicons:arrow-right" aria-hidden="true" /></a>
    </div>
    <div class="min-w-0 p-[clamp(22px,4vw,42px)]" data-code-example>
      <div class="flex border-2 border-black border-b-0" role="tablist" aria-label="Code example language">
        {codeExamples.map((example, index) => (
          <button
            class="cursor-pointer border-0 border-r-2 border-black bg-white px-4 py-2 text-[0.8rem] font-extrabold last:border-r-0 aria-selected:bg-black aria-selected:text-white"
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            data-code-tab={example.id}
          >{example.label}</button>
        ))}
      </div>
      {codeExamples.map((example, index) => (
        <pre class="max-h-[430px] max-w-full overflow-auto rounded-[0_0_3px_3px] border-2 border-black bg-white p-5 text-[0.78rem] leading-[1.6]" data-code-panel={example.id} hidden={index !== 0}><code>{example.code}</code></pre>
      ))}
    </div>
  </div>
</section>

<section class="mt-12" aria-labelledby="faq-heading">
  <p class="mb-3 font-mono text-[0.74rem] font-extrabold uppercase tracking-[0.14em]">Common questions</p>
  <h2 class="mb-6 font-heading text-[clamp(1.55rem,3vw,2.25rem)] font-normal leading-[1.05] tracking-[-0.04em]" id="faq-heading">{page.platform} scraper FAQ</h2>
  <div class="border-y-2 border-black">
    {faq.map((item) => (
      <details class="border-b-2 border-black last:border-b-0">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-extrabold marker:content-none">
          {item.question}
          <Icon class="size-5 shrink-0" name="heroicons:plus" aria-hidden="true" />
        </summary>
        <p class="max-w-[820px] pb-5 leading-[1.65]">{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<section class="mt-12 border-t-2 border-black pt-7" aria-labelledby="related-heading">
  <div class="flex items-end justify-between gap-6 max-[660px]:items-start max-[660px]:flex-col">
    <div>
      <p class="mb-2 font-mono text-[0.74rem] font-extrabold uppercase tracking-[0.14em]">More sources</p>
      <h2 class="font-heading text-[clamp(1.4rem,2.4vw,1.9rem)] font-normal leading-[1.06] tracking-[-0.04em]" id="related-heading">Connect more of the web.</h2>
    </div>
    <nav class="flex flex-wrap gap-3" aria-label="Related platform scrapers">
      {related.map((item) => <a class="border-2 border-black bg-white px-4 py-2 text-[0.84rem] font-extrabold no-underline hover:bg-black hover:text-white" href={`/${item.slug}/`}>{item.platform}</a>)}
    </nav>
  </div>
</section>

<script>
  const codeExample = document.querySelector<HTMLElement>('[data-code-example]');
  const codeTabs = [...(codeExample?.querySelectorAll<HTMLButtonElement>('[data-code-tab]') ?? [])];
  const codePanels = [...(codeExample?.querySelectorAll<HTMLElement>('[data-code-panel]') ?? [])];

  codeTabs.forEach((tab) => tab.addEventListener('click', () => {
    const language = tab.dataset.codeTab;
    codeTabs.forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
    codePanels.forEach((panel) => { panel.hidden = panel.dataset.codePanel !== language; });
  }));
</script>
