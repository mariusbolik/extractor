---
import { Icon } from 'astro-icon/components';
import { supportedPlatforms } from '../features/marketing/platforms';
import PlatformIcon from './PlatformIcon.astro';
---

<section aria-labelledby="supported-heading">
  <p class="mb-4 font-mono text-[0.8rem] font-extrabold uppercase tracking-[0.14em]">Supported sources</p>
  <h2 class="font-heading text-[clamp(1.55rem,3vw,2.4rem)] font-normal leading-[1.02] tracking-[-0.045em]" id="supported-heading">Supported platforms, handled properly.</h2>
  <p class="mt-3 mb-0 text-[0.82rem] font-bold uppercase tracking-[0.1em] md:hidden">Swipe to explore →</p>
  <div class="mt-6 grid snap-x snap-mandatory grid-flow-col auto-cols-[minmax(270px,82vw)] gap-[18px] overflow-x-auto overscroll-x-contain pb-3 lg:grid-flow-row lg:grid-cols-3 lg:overflow-visible lg:pb-0">
    {supportedPlatforms.map((platform, index) => (
      <a class="method-card group flex min-h-[240px] snap-start flex-col border-2 border-black bg-white p-6 no-underline transition duration-100 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[6px_6px_0_#000] hover:no-underline" href={platform.href}>
        <div class="flex items-start justify-between gap-6">
          <PlatformIcon {...platform} class="size-7 shrink-0" idSuffix="cards" />
          <p class="mb-0 text-right font-mono text-[0.74rem] font-extrabold uppercase leading-[1.45] tracking-[0.12em]">{String(index + 1).padStart(2, '0')} / {platform.detail}</p>
        </div>
        <h3 class="mt-8 mb-4 font-heading text-[1.15rem] font-normal leading-[1.02] tracking-[-0.045em]">{platform.name}</h3>
        <p class="leading-relaxed">{platform.description}</p>
        <span class="mt-5 block" aria-hidden="true">
          <Icon class="size-6 transition-transform duration-100 group-hover:translate-x-1" name="heroicons:arrow-right" />
        </span>
      </a>
    ))}
  </div>
</section>
