---
import { Icon } from 'astro-icon/components';
import { supportedPlatforms } from '../features/marketing/platforms';
import PlatformIcon from './PlatformIcon.astro';
---

<section aria-labelledby="supported-heading">
  <p class="mb-4 font-mono text-[0.8rem] font-extrabold uppercase tracking-[0.14em]">Supported sources</p>
  <h2 class="font-heading text-[clamp(1.55rem,3vw,2.4rem)] font-normal leading-[1.02] tracking-[-0.045em]" id="supported-heading">Supported platforms, handled properly.</h2>
  <ul class="mt-6 list-none border-2 border-black bg-white p-0 shadow-[8px_8px_0_#000] max-[660px]:shadow-[5px_5px_0_#000]">
    {supportedPlatforms.map((platform, index) => (
      <li class="border-b-2 border-black last:border-b-0">
        <a class="method-card group grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-5 bg-white px-[clamp(18px,3vw,30px)] py-5 no-underline transition-colors duration-100 hover:bg-neutral-100 hover:no-underline md:grid-cols-[auto_minmax(170px,0.42fr)_minmax(0,1fr)_auto] md:gap-x-7" href={platform.href}>
          <PlatformIcon {...platform} class="size-7 shrink-0" idSuffix="list" />
          <div>
            <p class="mb-2 font-mono text-[0.7rem] font-extrabold uppercase leading-[1.4] tracking-[0.12em]">{String(index + 1).padStart(2, '0')} / {platform.detail}</p>
            <h3 class="font-heading text-[1.08rem] font-normal leading-[1.05] tracking-[-0.04em]">{platform.name}</h3>
          </div>
          <p class="col-start-2 col-end-4 row-start-2 mt-3 leading-relaxed md:col-start-3 md:col-end-4 md:row-start-1 md:mt-0">{platform.description}</p>
          <span class="col-start-3 row-start-1 justify-self-end md:col-start-4" aria-hidden="true">
            <Icon class="size-6 transition-transform duration-100 group-hover:translate-x-1" name="heroicons:arrow-right" />
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
